# ---------------------------------------------------------------------------
# Sportz — environment template
#
# Copy to `.env` and adjust:
#     cp .env.example .env
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Database (required) ----------------------------------------------------
# Any PostgreSQL 14+ instance works. The default below targets the workspace
# local cluster created by `npm run db:start` (data dir ./.pgdata, port 5433).
#
#   macOS / Linux (Homebrew):
#     initdb -D ./.pgdata -U postgres --auth=trust
#     npm run db:start && npm run db:push
#
#   Docker alternative:
#     docker run -d --name sportz-db -p 5432:5432 \
#       -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=sportz postgres:16
#     DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/sportz?schema=public"
#
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/sportz?schema=public&connection_limit=10"

# --- Data source (provider ingest) ------------------------------------------
# "espn"  (default) — live fixtures via the public, keyless ESPN feed
# "sim"   — hand data control to the built-in simulator (`npm run seed`)
SPORTS_DATA=espn

# Which leagues to follow, comma-separated "sport:slug" pairs.
# Sport prefixes: football | basketball | cricket (ESPN path "soccer").
ESPN_LEAGUES=football:eng.1,football:esp.1,basketball:nba

# Fine tuning (defaults are deliberately gentle on ESPN's free feed).
# ESPN_POLL_MS=30000
# ESPN_BACKFILL_DAYS=3

# --- Rate limits (requests per minute, optional) ----------------------------
# Defaults (60 / 240 / 600) suit a real client. The simulation engine is much
# chattier, so local development raises them; see .env.
# RATE_LIMIT_MATCH_CREATE=600
# RATE_LIMIT_SCORE=6000
# RATE_LIMIT_COMMENTARY=12000

# --- Simulation engine ------------------------------------------------------
# Base URL the seed/simulator script calls (defaults to http://127.0.0.1:3000).
# SPORTZ_URL=http://127.0.0.1:3000

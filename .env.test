# ---------------------------------------------------------------------------
# Test environment. Never point this at your development database: the suite
# truncates tables between files.
#
#   createdb -h 127.0.0.1 -p 5433 -U postgres sportz_test
#   npm run test
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/sportz_test?schema=public&connection_limit=5"
NODE_ENV=test
PORT=3100

# Playwright runs the app itself on this port, against sportz_test.
#
# It must be the default port: `next dev` takes a lock on the project directory,
# so a second dev server cannot start on another port while `npm run dev` is up.
# The E2E run therefore owns port 3000 for its duration — stop your own dev
# server first (or let Playwright replace it) and restart it afterwards.
E2E_PORT=3000

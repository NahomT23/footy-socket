# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build Outputs
/.next/
/out/
/build
/dist
.turbo/

# Local development services & caches (never commit database clusters)
/.pgdata/
/.cache/

# Environment Variables & Secrets (Prevent accidental leaks)
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
*.env.*
*.env.local

# Whitelist safe example/template environment files for the team/repo
!.env.example
!.env*.example
!.env.sample
!.env*.sample
!.env.template
!.env*.template

# The test environment is a committed template, not a secret: it points at a
# throwaway `sportz_test` database and is required by `npm test`.
!.env.test

# Credentials, Keys, and Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.cer
*.der
credentials.json
client_secret*.json
*service-account*.json
*firebase-adminsdk*.json
.env.vault
*.secret
*.secrets
id_rsa*
id_ed25519*

# Package Manager Auth Tokens (prevents leaking registry credentials)
.npmrc
.yarnrc

# Testing & Coverage
/coverage
.nyc_output

# Debug & Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# IDEs and Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
